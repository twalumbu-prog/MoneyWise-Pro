<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- RECEIVE_SMS / READ_SMS are added by app.config.ts (MOMO_SMS_CAPTURE) so a store build can ship without them
       until Google Play approves the SMS permission declaration; without them this receiver simply never fires. -->
  <application>
    <service
      android:name="expo.modules.momocapture.MomoNotificationListener"
      android:label="MoneyWise mobile money capture"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <receiver
      android:name="expo.modules.momocapture.MomoSmsReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
