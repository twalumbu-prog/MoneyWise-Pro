<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- RECEIVE_SMS / READ_SMS are added by app.config.ts (MOMO_SMS_CAPTURE) so a store build can ship without them
       until Google Play approves the SMS permission declaration; without them this receiver simply never fires. -->
  <!-- The SMS permissions make Android assume a SIM is required, which hid the app from ~4,000 tablets and other
       devices without one on Google Play. A SIM is optional: without one, capture works through notifications. -->
  <uses-feature android:name="android.hardware.telephony" android:required="false" />
  <!-- For the "Record / Dismiss" prompt shown when a transaction is captured. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Android 16: lets the "Offline" status appear in the phone's own island / status-bar chip (no prompt; a normal permission). -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <application>
    <receiver android:name="expo.modules.momocapture.MomoPromptReceiver" android:exported="false" />
    <!-- Re-sends queued messages when the phone is back online. -->
    <service
      android:name="expo.modules.momocapture.MomoRetryJob"
      android:permission="android.permission.BIND_JOB_SERVICE"
      android:exported="false" />
    <service
      android:name="expo.modules.momocapture.MomoNotificationListener"
      android:label="MoneyWise mobile money capture"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <receiver
      android:name="expo.modules.momocapture.MomoSmsReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
