# Local Expo modules keep their native source in modules/<name>/android and /ios — only the generated app project is ignored.
!/modules/*/android/
!/modules/*/ios/
/modules/*/android/build/
*.log

# Local env (contains project keys)
.env

# Firebase app config for Android push. Builds get it from the GOOGLE_SERVICES_JSON EAS file variable
# (see docs/android-push-setup.md), so a local copy is only for this machine. Never commit Firebase
# service-account keys (*-firebase-adminsdk-*.json) either: those belong in Expo credentials only.
google-services.json
*-firebase-adminsdk-*.json

